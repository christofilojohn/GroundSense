<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Camera access — required for ARKit -->
	<key>NSCameraUsageDescription</key>
	<string>GroundSense uses the camera for real-time scene segmentation via ARKit.</string>

	<!-- Microphone access — required for STT voice queries -->
	<key>NSMicrophoneUsageDescription</key>
	<string>GroundSense listens for voice queries such as "What is to my left?"</string>

	<!-- Speech recognition — required for SFSpeechRecognizer -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>GroundSense transcribes your voice queries to answer spatial questions about the scene.</string>

	<!-- Local network — required to reach the WebSocket server over Wi-Fi -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>GroundSense connects to a local backend server to process depth and camera frames.</string>

	<!-- Bonjour services listed so iOS shows the local-network permission prompt -->
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_groundsense._tcp</string>
	</array>

	<!-- Allow plain ws:// WebSocket connections (not wss://) to the local server -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- ARKit is mandatory; LiDAR is desirable but the app falls back to RGB-only -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arkit</string>
	</array>

	<!-- Portrait orientation only makes sense for a handheld assistive app -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UILaunchScreen</key>
	<dict/>

	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
</dict>
</plist>
